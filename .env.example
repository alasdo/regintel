# Copy to .env and fill in. .env is gitignored and Claude is blocked from reading it.
# List every variable the app needs, with a placeholder and a comment.
# EXAMPLE_API_KEY=changeme   # where to get it

# Hugging Face write token for the dataset (https://huggingface.co/settings/tokens).
# Also stored as the HF_TOKEN secret in GitHub Actions.
HF_TOKEN=changeme
# Dataset repo that holds raw/ letters and the manifest.
REGINTEL_DATASET=alasdo/regintel-data
# Local cache for fetched-but-unpushed pages (default data/cache).
# REGINTEL_CACHE_DIR=data/cache
